# Copy this file to .env and fill in what you need. Everything has a default.

# --- Model ------------------------------------------------------------------
# anthropic (default) | openai | fake (offline demo content, no key needed)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 (Anthropic) or gpt-6.1-sol (OpenAI).
# For lower cost with Claude, try claude-sonnet-5-5.
# LLM_MODEL=
# Requests declined by Claude's safety classifiers are retried on Anthropic's
# recommended fallback model. Set to false to turn this off.
# ANTHROPIC_REFUSAL_FALLBACKS=true

# OpenAI, or any OpenAI-compatible server such as vLLM or Ollama
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# "chat" uses Chat Completions, which OpenAI-compatible servers implement
# OPENAI_API_MODE=responses

# --- Research ---------------------------------------------------------------
# web: research each section with the provider's web search before writing it
# (better facts and real sources, at some extra cost). none: skip research.
# RESEARCH_BACKEND=web
# RESEARCH_MAX_SEARCHES=3

# --- How hard the model thinks for each task: low | medium | high ----------
# EFFORT_DIAGNOSTICS=low
# EFFORT_PLAN=medium
# EFFORT_RESEARCH=low
# EFFORT_SECTION=medium
# EFFORT_TUTOR=low

# --- Database ---------------------------------------------------------------
# Local Postgres (docker compose sets this itself for the app container)
DATABASE_URL=postgresql://marginalia:marginalia@localhost:5432/marginalia
# Supabase: copy a connection string from your project's Connect dialog, e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
